<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Auto-detect test framework and define constants -->
  <Target Name="TiverFowlDetectTestFramework" BeforeTargets="CoreCompile">

    <!-- Detect NUnit -->
    <PropertyGroup Condition="'%(PackageReference.Identity)' == 'NUnit'">
      <DefineConstants>$(DefineConstants);TIVER_NUNIT</DefineConstants>
    </PropertyGroup>

    <!-- Detect MSTest -->
    <PropertyGroup Condition="'%(PackageReference.Identity)' == 'MSTest.TestFramework'">
      <DefineConstants>$(DefineConstants);TIVER_MSTEST</DefineConstants>
    </PropertyGroup>

  </Target>

</Project>
