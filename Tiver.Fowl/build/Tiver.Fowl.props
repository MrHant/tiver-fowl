<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Auto-detect test framework based on package references -->
  <!-- Runs before build preparation for early IDE IntelliSense support -->
  <Target Name="TiverFowlDetectTestFrameworkEarly" BeforeTargets="BeforeCompile;CoreCompile;_GenerateCompileDependencyCache">

    <!-- Check for PackageReference to NUnit -->
    <ItemGroup>
      <TiverNUnitPackageReference Include="@(PackageReference)"
          Condition="'%(PackageReference.Identity)' == 'NUnit'" />
    </ItemGroup>

    <!-- Check for PackageReference to MSTest.TestFramework or MSTest -->
    <ItemGroup>
      <TiverMSTestPackageReference Include="@(PackageReference)"
          Condition="'%(PackageReference.Identity)' == 'MSTest.TestFramework' OR '%(PackageReference.Identity)' == 'MSTest'" />
    </ItemGroup>

    <!-- Define TIVER_NUNIT if NUnit is found -->
    <PropertyGroup Condition="'@(TiverNUnitPackageReference)' != ''">
      <DefineConstants>$(DefineConstants);TIVER_NUNIT</DefineConstants>
    </PropertyGroup>

    <!-- Define TIVER_MSTEST if MSTest is found -->
    <PropertyGroup Condition="'@(TiverMSTestPackageReference)' != ''">
      <DefineConstants>$(DefineConstants);TIVER_MSTEST</DefineConstants>
    </PropertyGroup>

  </Target>

</Project>
