<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Auto-detect test framework based on package references at evaluation time -->
  <!-- This runs early enough for IDE IntelliSense to recognize the symbols -->

  <!-- Define TIVER_NUNIT if NUnit package is referenced -->
  <PropertyGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'NUnit'))' != ''">
    <DefineConstants>$(DefineConstants);TIVER_NUNIT</DefineConstants>
  </PropertyGroup>

  <!-- Define TIVER_MSTEST if MSTest.TestFramework package is referenced -->
  <PropertyGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'MSTest.TestFramework'))' != ''">
    <DefineConstants>$(DefineConstants);TIVER_MSTEST</DefineConstants>
  </PropertyGroup>

</Project>
