<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <TargetFramework>net10.0</TargetFramework>

        <!-- NuGet Package Metadata -->
        <Authors>Artsiomi Silivonchyk</Authors>
        <Description>A framework for writing Automated Integration tests (including tests via Selenium).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MrHant/tiver-fowl</PackageProjectUrl>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <CodeAnalysisDictionary Include="..\CustomCodeAnalysisDictionary.xml">
        <Link>CustomCodeAnalysisDictionary.xml</Link>
      </CodeAnalysisDictionary>
    </ItemGroup>

    <!-- README for package -->
    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Content files to be included in package (starter templates) -->
    <ItemGroup>
      <Content Include="contentFiles\cs\any\**\*.template">
        <Pack>true</Pack>
        <PackagePath>contentFiles\cs\any\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
        <CopyToOutput>false</CopyToOutput>
      </Content>
    </ItemGroup>

    <!-- Source files shipped to be compiled in consumer project -->
    <!-- Files in contentFiles/cs/ are automatically compiled by NuGet -->
    <ItemGroup>
      <Compile Remove="contentFiles\cs\any\**\*.cs" />
      <None Include="contentFiles\cs\any\**\*.cs" Pack="true" PackagePath="contentFiles\cs\any\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Auto-detect test framework and define constants -->
    <!-- This gets evaluated in the consuming project -->
    <ItemGroup>
      <Content Include="build\Tiver.Fowl.targets">
        <Pack>true</Pack>
        <PackagePath>build\</PackagePath>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration">
        <Version>10.0.0</Version>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder">
        <Version>10.0.0</Version>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Configuration.Json">
        <Version>10.0.0</Version>
      </PackageReference>
      <PackageReference Include="MinVer">
        <Version>6.0.0</Version>
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Selenium.WebDriver">
        <Version>4.38.0</Version>
      </PackageReference>
      <PackageReference Include="Serilog">
        <Version>4.3.0</Version>
      </PackageReference>
      <PackageReference Include="Tiver.Fowl.Drivers">
        <Version>0.6.0-alpha.5</Version>
      </PackageReference>
      <PackageReference Include="Tiver.Fowl.Waiting">
        <Version>0.5.0-alpha</Version>
      </PackageReference>
    </ItemGroup>

</Project>
