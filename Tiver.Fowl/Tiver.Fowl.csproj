<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>14</LangVersion>
        <TargetFramework>net10.0</TargetFramework>

        <!-- NuGet Package Metadata -->
        <Authors>Artsiomi Silivonchyk</Authors>
        <Description>A framework for writing Automated Integration tests (including tests via Selenium).</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/MrHant/tiver-fowl</PackageProjectUrl>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- In Development configuration, disable auto-include to avoid duplicates -->
    <PropertyGroup Condition="'$(Configuration)' == 'Development'">
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>

    <ItemGroup>
      <CodeAnalysisDictionary Include="..\CustomCodeAnalysisDictionary.xml">
        <Link>CustomCodeAnalysisDictionary.xml</Link>
      </CodeAnalysisDictionary>
    </ItemGroup>

    <!-- README for package -->
    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- Content files to be included in package (starter templates) -->
    <ItemGroup>
      <Content Include="contentFiles\cs\any\**\*.template">
        <Pack>true</Pack>
        <PackagePath>contentFiles\cs\any\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
        <CopyToOutput>false</CopyToOutput>
      </Content>
    </ItemGroup>

    <!-- Source files shipped to be compiled in consumer project -->
    <!-- Must use Content with BuildAction=Compile to generate contentFiles entry in nuspec -->
    <!-- In Development configuration, also compile them to catch errors before packaging -->
    <ItemGroup Condition="'$(Configuration)' != 'Development'">
      <Compile Remove="contentFiles\cs\any\**\*.cs" />
      <Content Include="contentFiles\cs\any\**\*.cs">
        <Pack>true</Pack>
        <PackagePath>contentFiles\cs\any\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <BuildAction>Compile</BuildAction>
        <CopyToOutput>false</CopyToOutput>
      </Content>
    </ItemGroup>

    <!-- In Development configuration: compile contentFiles AND include in package -->
    <ItemGroup Condition="'$(Configuration)' == 'Development'">
      <!-- Include all main source files -->
      <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
      <!-- contentFiles are already included above, so this adds them for compilation -->
      <Content Include="contentFiles\cs\any\**\*.cs">
        <Pack>true</Pack>
        <PackagePath>contentFiles\cs\any\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <BuildAction>Compile</BuildAction>
        <CopyToOutput>false</CopyToOutput>
      </Content>
    </ItemGroup>

    <!-- Auto-detect test framework and define constants -->
    <ItemGroup>
      <Content Include="build\Tiver.Fowl.targets">
        <Pack>true</Pack>
        <PackagePath>build\</PackagePath>
      </Content>
    </ItemGroup>

    <!-- Report template file -->
    <ItemGroup>
      <None Include="Core\Reporting\report-template.html">
        <Link>report-template.html</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Pack>true</Pack>
        <PackagePath>lib\$(TargetFramework)\</PackagePath>
      </None>
    </ItemGroup>

    <!-- Test framework references - only for Development configuration to compile contentFiles -->
    <ItemGroup Condition="'$(Configuration)' == 'Development'">
      <PackageReference Include="NUnit" Version="4.4.0" />
      <PackageReference Include="MSTest.TestFramework" Version="3.8.1" />
    </ItemGroup>

    <!-- Import targets to auto-detect test frameworks in Development configuration -->
    <Import Project="build\Tiver.Fowl.targets" Condition="'$(Configuration)' == 'Development'" />

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration">
        <Version>10.0.0</Version>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder">
        <Version>10.0.0</Version>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Configuration.Json">
        <Version>10.0.0</Version>
      </PackageReference>
      <PackageReference Include="MinVer">
        <Version>6.0.0</Version>
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Selenium.WebDriver">
        <Version>4.38.0</Version>
      </PackageReference>
      <PackageReference Include="Serilog">
        <Version>4.3.0</Version>
      </PackageReference>
      <PackageReference Include="Serilog.Sinks.Console">
        <Version>6.1.1</Version>
      </PackageReference>
      <PackageReference Include="Serilog.Sinks.File">
        <Version>7.0.0</Version>
      </PackageReference>
      <PackageReference Include="Serilog.Extensions.Logging">
        <Version>9.0.2</Version>
      </PackageReference>
      <PackageReference Include="Tiver.Fowl.Drivers">
        <Version>0.6.0-alpha.5</Version>
      </PackageReference>
      <PackageReference Include="Tiver.Fowl.Waiting">
        <Version>0.5.0-alpha</Version>
      </PackageReference>
    </ItemGroup>

</Project>
