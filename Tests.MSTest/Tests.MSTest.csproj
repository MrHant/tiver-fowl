<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Versions come from ../Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Serilog is intentionally not referenced here: the shipped Logger.cs contentFile is compiled
         in this project and types against Serilog, so building proves those compile assets flow
         transitively from Tiver.Fowl as documented in README.md. -->
    <!-- VersionOverride, not Version: central package management permits one version per package
         id, and Directory.Build.targets packs this project's copy under its own sentinel so the
         two consumer projects never share a package. See Directory.Packages.props. -->
    <PackageReference Include="Tiver.Fowl" VersionOverride="[0.0.1-testingmstest]" />
  </ItemGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../test-packages</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Tiver_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
