<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Link contentFiles for compilation validation -->
    <ItemGroup>
        <Compile Include="..\Tiver.Fowl\contentFiles\cs\any\**\*.cs" Link="ContentFiles\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- Import Tiver.Fowl targets for auto-detection -->
    <Import Project="..\Tiver.Fowl\build\Tiver.Fowl.targets" />

    <!-- Reference the main framework -->
    <ItemGroup>
        <ProjectReference Include="..\Tiver.Fowl\Tiver.Fowl.csproj" />
    </ItemGroup>

    <!-- Both test frameworks to validate both BaseTest variants -->
    <!-- Versions come from ../Directory.Packages.props. -->
    <ItemGroup>
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="MSTest.TestFramework" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
    </ItemGroup>

</Project>
