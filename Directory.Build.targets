<Project>
  <Target Name="PackTiverFowlForTesting"
          BeforeTargets="Restore;_GenerateRestoreGraphProjectEntry"
          Condition="('$(MSBuildProjectName)' == 'Tests.NUnit' OR '$(MSBuildProjectName)' == 'Tests.MSTest') AND '$(MSBuildIsRestoring)' == 'true'">
    <PropertyGroup>
      <TiverFowlTestVersion Condition="'$(MSBuildProjectName)' == 'Tests.NUnit'">0.0.1-testingnunit</TiverFowlTestVersion>
      <TiverFowlTestVersion Condition="'$(MSBuildProjectName)' == 'Tests.MSTest'">0.0.1-testingmstest</TiverFowlTestVersion>
      <TestPackagesDir>$(MSBuildThisFileDirectory)test-packages</TestPackagesDir>
      <PackagePath>$(TestPackagesDir)/Tiver.Fowl.$(TiverFowlTestVersion).nupkg</PackagePath>
      <TiverFowlProject>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Tiver.Fowl', 'Tiver.Fowl.csproj'))</TiverFowlProject>
      <!-- Build Development to validate contentFiles compilation, but pack in Release so contentFiles aren't compiled into the library assembly. -->
      <!-- Paths must end with a trailing slash; use '/' to avoid cmd.exe escaping issues on Windows. -->
      <TestPackIntermediateDirDevelopmentMsbuild>$([System.IO.Path]::Combine('$(TestPackagesDir)', '.obj', '$(TiverFowlTestVersion)', 'Development'))/</TestPackIntermediateDirDevelopmentMsbuild>
      <TestPackIntermediateDirReleaseMsbuild>$([System.IO.Path]::Combine('$(TestPackagesDir)', '.obj', '$(TiverFowlTestVersion)', 'Release'))/</TestPackIntermediateDirReleaseMsbuild>
      <TestPackBaseOutputDirMsbuild>$([System.IO.Path]::Combine('$(TestPackagesDir)', '.bin', '$(TiverFowlTestVersion)'))/</TestPackBaseOutputDirMsbuild>
    </PropertyGroup>

    <!-- Always rebuild with Development configuration to catch contentFiles errors -->
    <MakeDir Directories="$(TestPackagesDir)" />
    <RemoveDir Directories="$(NuGetPackageRoot)tiver.fowl/$(TiverFowlTestVersion)" />
    <Exec Command="dotnet build &quot;$(TiverFowlProject)&quot; -c Development -p:IntermediateOutputPath=&quot;$(TestPackIntermediateDirDevelopmentMsbuild)&quot; -p:BaseOutputPath=&quot;$(TestPackBaseOutputDirMsbuild)&quot;" />
    <Exec Command="dotnet pack &quot;$(TiverFowlProject)&quot; -c Release -o &quot;$(TestPackagesDir)&quot; -p:MinVerVersionOverride=$(TiverFowlTestVersion) -p:IntermediateOutputPath=&quot;$(TestPackIntermediateDirReleaseMsbuild)&quot; -p:BaseOutputPath=&quot;$(TestPackBaseOutputDirMsbuild)&quot; --force" />
  </Target>
</Project>
