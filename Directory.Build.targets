<Project>
  <Target Name="PackTiverFowlForTesting"
          BeforeTargets="Restore;_GenerateRestoreGraphProjectEntry"
          Condition="('$(MSBuildProjectName)' == 'Tests.NUnit' OR '$(MSBuildProjectName)' == 'Tests.MSTest') AND '$(MSBuildIsRestoring)' == 'true'">
    <PropertyGroup>
      <TiverFowlTestVersion Condition="'$(MSBuildProjectName)' == 'Tests.NUnit'">0.0.1-testingnunit</TiverFowlTestVersion>
      <TiverFowlTestVersion Condition="'$(MSBuildProjectName)' == 'Tests.MSTest'">0.0.1-testingmstest</TiverFowlTestVersion>
      <TestPackagesDir>$(MSBuildThisFileDirectory)test-packages</TestPackagesDir>
      <PackagePath>$(TestPackagesDir)/Tiver.Fowl.$(TiverFowlTestVersion).nupkg</PackagePath>
      <TiverFowlProject>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Tiver.Fowl', 'Tiver.Fowl.csproj'))</TiverFowlProject>
      <!-- Build Development to validate contentFiles compilation, but pack in Release so contentFiles aren't compiled into the library assembly. -->
      <!-- Paths must end with a trailing slash. On Windows, quoted args ending with '\' need it doubled to avoid escaping the closing quote. -->
      <_IsWindows Condition="'$(OS)' == 'Windows_NT'">true</_IsWindows>
      <TestPackIntermediateDirDevelopmentMsbuild Condition="'$(_IsWindows)' == 'true'">$([System.IO.Path]::Combine('$(TestPackagesDir)', '.obj', '$(TiverFowlTestVersion)', 'Development'))\\</TestPackIntermediateDirDevelopmentMsbuild>
      <TestPackIntermediateDirReleaseMsbuild Condition="'$(_IsWindows)' == 'true'">$([System.IO.Path]::Combine('$(TestPackagesDir)', '.obj', '$(TiverFowlTestVersion)', 'Release'))\\</TestPackIntermediateDirReleaseMsbuild>
      <TestPackBaseOutputDirMsbuild Condition="'$(_IsWindows)' == 'true'">$([System.IO.Path]::Combine('$(TestPackagesDir)', '.bin', '$(TiverFowlTestVersion)'))\\</TestPackBaseOutputDirMsbuild>
      <TestPackIntermediateDirDevelopmentMsbuild Condition="'$(_IsWindows)' != 'true'">$([System.IO.Path]::Combine('$(TestPackagesDir)', '.obj', '$(TiverFowlTestVersion)', 'Development'))/</TestPackIntermediateDirDevelopmentMsbuild>
      <TestPackIntermediateDirReleaseMsbuild Condition="'$(_IsWindows)' != 'true'">$([System.IO.Path]::Combine('$(TestPackagesDir)', '.obj', '$(TiverFowlTestVersion)', 'Release'))/</TestPackIntermediateDirReleaseMsbuild>
      <TestPackBaseOutputDirMsbuild Condition="'$(_IsWindows)' != 'true'">$([System.IO.Path]::Combine('$(TestPackagesDir)', '.bin', '$(TiverFowlTestVersion)'))/</TestPackBaseOutputDirMsbuild>
      <!-- NuGetPackageRoot comes from obj/*.nuget.g.props, which restore deliberately does not
           import (ExcludeRestorePackageImports). Resolve the global packages folder ourselves,
           otherwise the RemoveDir below silently targets a relative path that never exists and
           the consumer projects restore a stale, previously extracted package. -->
      <TiverFowlPackageRoot>$(NuGetPackageRoot)</TiverFowlPackageRoot>
      <TiverFowlPackageRoot Condition="'$(TiverFowlPackageRoot)' == ''">$(NUGET_PACKAGES)</TiverFowlPackageRoot>
      <TiverFowlPackageRoot Condition="'$(TiverFowlPackageRoot)' == ''">$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.UserProfile)), '.nuget', 'packages'))</TiverFowlPackageRoot>
      <TiverFowlCachedPackageDir>$([System.IO.Path]::Combine('$(TiverFowlPackageRoot)', 'tiver.fowl', '$(TiverFowlTestVersion)'))</TiverFowlCachedPackageDir>
    </PropertyGroup>

    <!-- Always rebuild with Development configuration to catch contentFiles errors -->
    <MakeDir Directories="$(TestPackagesDir)" />
    <Message Importance="High" Text="Clearing extracted test package: $(TiverFowlCachedPackageDir)" />
    <RemoveDir Directories="$(TiverFowlCachedPackageDir)" />
    <Exec Command="dotnet build &quot;$(TiverFowlProject)&quot; -c Development -p:IntermediateOutputPath=&quot;$(TestPackIntermediateDirDevelopmentMsbuild)&quot; -p:BaseOutputPath=&quot;$(TestPackBaseOutputDirMsbuild)&quot; -v:m"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
    <Exec Command="dotnet pack &quot;$(TiverFowlProject)&quot; -c Release -o &quot;$(TestPackagesDir)&quot; -p:MinVerVersionOverride=$(TiverFowlTestVersion) -p:IntermediateOutputPath=&quot;$(TestPackIntermediateDirReleaseMsbuild)&quot; -p:BaseOutputPath=&quot;$(TestPackBaseOutputDirMsbuild)&quot; --force -v:m"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High" />
  </Target>
</Project>
